PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional — ohne diese beiden wird nur geloggt statt E-Mail versendet
# (siehe lib/server/email.ts). RESEND_API_KEY aus dem Resend-Dashboard,
# MAIL_FROM braucht eine bei Resend verifizierte Domain.
RESEND_API_KEY=re_...
MAIL_FROM=PadelIndex <benachrichtigungen@padelindex.de>

# Optional — schaltet /admin (Super-Admin-Dashboard) frei. Ohne diese
# Variable ist /admin für niemanden erreichbar, siehe
# lib/server/platform-owner.ts. Muss exakt der Login-E-Mail entsprechen.
PLATFORM_OWNER_EMAIL=du@example.com
