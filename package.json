{
	"name": "padelindex",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "WRANGLER_HOME=.wrangler vite dev",
		"build": "vite build",
		"preview": "npm run build && WRANGLER_HOME=.wrangler wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"import:bavaro": "node scripts/run.mjs scripts/import-bavaro.ts",
		"icons": "node scripts/run.mjs scripts/generate-icons.ts",
		"cap:sync": "cap sync",
		"cap:open:android": "cap open android",
		"cap:open:ios": "cap open ios"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"leaflet": "^1.9.4",
		"openskill": "^5.0.1",
		"satori": "^0.29.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/leaflet": "^1.9.22",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	}
}
